{
  // Cloudflare Worker: serve o app (public/) e a API (/api/*).
  // O nome abaixo precisa ser igual ao nome do Worker no painel da Cloudflare.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "amanda-study-app",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [
      { "name": "STORE", "class_name": "FamilyStore" },
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "CURRICULUM", "class_name": "Curriculum" },
      { "name": "BANK", "class_name": "Bank" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FamilyStore"] },
    { "tag": "v2", "new_sqlite_classes": ["Directory"] },
    { "tag": "v3", "new_sqlite_classes": ["Curriculum"] },
    { "tag": "v4", "new_sqlite_classes": ["Bank"] }
  ],
  "vars": {
    // Modelos do Claude: planejar a semana e corrigir fotos (mais capaz) / extras e dicas (rápido).
    "MODEL_PLAN": "claude-sonnet-5-5",
    "MODEL_FAST": "claude-haiku-5-5",
    // Limites de gasto com o Claude (US$): por criança por dia e total do app por mês.
    "CHILD_DAILY_USD": "0.50",
    "MONTHLY_USD": "40"
  },
  "observability": { "enabled": true }
}
